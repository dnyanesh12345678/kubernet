      cpu: 50m
    limits:
      memory: 200Mi
      cpu: 100m

kube-state-metrics:
  resources:
    requests:
      memory: 100Mi
      cpu: 100m
    limits:
      memory: 300Mi
      cpu: 200m

# Security improvement
defaultRules:
  create: true
