✅ Production-Ready values-prod.yaml
Use this as a strong baseline:

mode: deployment

replicaCount: 2   # High availability

image:
  repository: otel/opentelemetry-collector-contrib
  pullPolicy: IfNotPresent

service:
  type: ClusterIP
  ports:
    otlp-grpc:
      enabled: true
      containerPort: 4317
      servicePort: 4317
    otlp-http:
      enabled: true
      containerPort: 4318
      servicePort: 4318
    metrics:
      enabled: true
      containerPort: 8888
      servicePort: 8888

resources:
  requests:
    cpu: 200m
    memory: 512Mi
  limits:
    cpu: 500m
    memory: 1Gi

autoscaling:
  enabled: true
  minReplicas: 2
  maxReplicas: 5
  targetCPUUtilizationPercentage: 70

config:
  extensions:
    health_check:
      endpoint: 0.0.0.0:13133

  receivers:
    otlp:
      protocols:
        grpc:
        http:

  processors:
    memory_limiter:
      check_interval: 1s
      limit_mib: 800
      spike_limit_mib: 200
    batch:

  exporters:
    logging:
      loglevel: info

  service:
    extensions: [health_check]
    pipelines:
      traces:
        receivers: [otlp]
        processors: [memory_limiter, batch]
        exporters: [logging]

      metrics:
        receivers: [otlp]
        processors: [memory_limiter, batch]
        exporters: [logging]

      logs:
        receivers: [otlp]
        processors: [memory_limiter, batch]
        exporters: [logging]
🧠 Why These Production Changes?
Setting	Why Important
replicaCount: 2	High availability
memory_limiter	Prevent OOM kill
batch processor	Improve performance
resource limits	Protect cluster stability
autoscaling	Handle traffic spikes
ClusterIP	Internal only
health_check	Required for probes
🎯 STEP 3 — Create Namespace
kubectl create namespace observability
