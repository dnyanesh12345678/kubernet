🛠️ 8️⃣ Airflow DAG To Trigger It
In Airflow:

from airflow import DAG
from airflow.operators.python import PythonOperator
from datetime import datetime
import requests

def trigger_job():
    response = requests.post(
        "http://job-api.airflow.svc.cluster.local:8080/api/jobs/run"
    )
    print(response.text)

with DAG(
    dag_id="trigger_job_api",
    start_date=datetime(2024,1,1),
    schedule_interval="*/5 * * * *",
    catchup=False
) as dag:

    task = PythonOperator(
        task_id="call_job_api",
        python_callable=trigger_job
    )
