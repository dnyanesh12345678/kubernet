#!/bin/bash

while true; do

  students=$(kubectl get students -o jsonpath='{.items[*].metadata.name}')

  for student in $students; do

    podname="${student}-pod"

    # Check if pod exists
    if ! kubectl get pod $podname &> /dev/null; then
      echo "Creating pod for $student"

      kubectl run $podname --image=nginx --restart=Never

      # Update status
      kubectl patch student $student --type merge \
        -p '{"status":{"phase":"Running"}}' \
        --subresource=status
    fi

  done

  sleep 5
done
