kind: RoleBinding
metadata:
  name: qa-rolebinding
  namespace: qa
subjects:
  - kind: User
    name: qa-user       # must match CN from certificate
    apiGroup: rbac.authorization.k8s.io
roleRef:
  kind: Role
  name: qa-role
  apiGroup: rbac.authorization.k8s.io
Apply it:

kubectl apply -f role-qa.yaml
kubectl apply -f rolebinding-qa.yaml
🔹 Step 7: QA User Uses kubeconfig
