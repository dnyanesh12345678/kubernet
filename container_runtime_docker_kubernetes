3) The playbook: migrate-runtime.yml
---
# Migrate Kubernetes nodes from Docker runtime (dockershim) to containerd or CRI-O
# Run example:
#   ansible-playbook -i inventory.ini migrate-runtime.yml -e "limit_nodes=worker1"
#   ansible-playbook -i inventory.ini migrate-runtime.yml   # (for all nodes in group)

- name: Migrate container runtime on Kubernetes nodes
  hosts: "{{ limit_nodes | default(kube_nodes_group, true) }}"
  gather_facts: yes
  become: yes
  vars:
    kube_nodes_group: "k8s_nodes"
    runtime_choice: "containerd"   # options: containerd | crio
    # Kubectl options (assumes kubectl works from the controller where you run this play)
    kubectl_bin: "kubectl"
    kubectl_context: ""            # e.g., "my-context" or leave empty
    kube_wait_timeout: "600s"

    # Containerd settings
    containerd_service: "containerd"
    containerd_socket: "unix:///run/containerd/containerd.sock"
    crio_service: "crio"
    crio_socket: "unix:///var/run/crio/crio.sock"

    # Paths for kubelet flags (kubeadm-based installs)
    kubelet_flags_file: "/var/lib/kubelet/kubeadm-flags.env"
    kubelet_dropin: "/etc/systemd/system/kubelet.service.d/10-kubeadm.conf"

  pre_tasks:
    - name: Compute kubectl base command
      set_fact:
        _kubectl_cmd: >-
          {{ kubectl_bin }}{{ ' --context ' + kubectl_context if kubectl_context|length>0 else '' }}

    - name: Get this node's name as known to Kubernetes (match by hostname)
      command: "hostname -s"
      register: _shortname

    - name: Cordon node (via kubectl on localhost)
      delegate_to: localhost
      become: false
      command: "{{ _kubectl_cmd }} cordon {{ _shortname.stdout }}"
      ignore_errors: yes

    - name: Drain node safely (ignore DaemonSets, keep emptyDir data)
      delegate_to: localhost
      become: false
      command: >-
        {{ _kubectl_cmd }} drain {{ _shortname.stdout }}
        --ignore-daemonsets
        --delete-emptydir-data=false
        --grace-period=30
        --timeout=300s
      register: _drain_result
      failed_when: _drain_result.rc not in [0] and
                   ('already cordoned' not in _drain_result.stderr|lower) and
                   ('is already drained' not in _drain_result.stderr|lower)
      changed_when: "'drained' in _drain_result.stdout|lower or 'cordoned' in _drain_result.stdout|lower"

  tasks:
    - name: Ensure required tools present for runtime (apt cache update on Debian/Ubuntu)
      when: ansible_facts['os_family'] == "Debian"
      apt:
        update_cache: yes
        cache_valid_time: 3600

    - name: Install runtime - containerd (Debian/Ubuntu)
      when: runtime_choice == "containerd" and ansible_facts['os_family'] == "Debian"
      apt:
        name: [ "containerd" ]
        state: present

    - name: Install runtime - containerd (RHEL/CentOS/Rocky/Alma)
      when: runtime_choice == "containerd" and ansible_facts['os_family'] == "RedHat"
      yum:
        name: [ "containerd" ]
        state: present

    - name: Generate default containerd config if missing
      when: runtime_choice == "containerd"
      shell: |
        set -e
        mkdir -p /etc/containerd
        [ -s /etc/containerd/config.toml ] || containerd config default > /etc/containerd/config.toml
      args:
        creates: /etc/containerd/config.toml

    - name: Ensure containerd uses SystemdCgroup = true (recommended by Kubernetes)
      when: runtime_choice == "containerd"
      replace:
        path: /etc/containerd/config.toml
        regexp: 'SystemdCgroup\s*=\s*false'
        replace: 'SystemdCgroup = true'
      notify: Restart containerd

    - name: Enable and start containerd
      when: runtime_choice == "containerd"
      systemd:
        name: "{{ containerd_service }}"
        state: started
        enabled: yes

    - name: Install CRI-O (Debian/Ubuntu)
      when: runtime_choice == "crio" and ansible_facts['os_family'] == "Debian"
      apt:
        name: [ "cri-o", "cri-o-runc" ]
        state: present

    - name: Install CRI-O (RHEL/CentOS/Rocky/Alma)
      when: runtime_choice == "crio" and ansible_facts['os_family'] == "RedHat"
      yum:
        name: [ "cri-o" ]
        state: present

    - name: Enable and start CRI-O
      when: runtime_choice == "crio"
      systemd:
        name: "{{ crio_service }}"
        state: started
        enabled: yes

    - name: Configure crictl to talk to the selected runtime
      copy:
        dest: /etc/crictl.yaml
        owner: root
        group: root
        mode: "0644"
        content: |
          runtime-endpoint: {{ containerd_socket if runtime_choice == 'containerd' else crio_socket }}
          image-endpoint:   {{ containerd_socket if runtime_choice == 'containerd' else crio_socket }}
          timeout: 10
          debug: false

    - name: Backup kubelet flags (once)
      copy:
        src: "{{ kubelet_flags_file }}"
        dest: "{{ kubelet_flags_file }}.backup_dockershim"
        remote_src: yes
      ignore_errors: yes

    - name: Ensure kubelet uses remote CRI endpoint (idempotent edit of kubeadm-flags.env)
      lineinfile:
        path: "{{ kubelet_flags_file }}"
        backrefs: yes
        regexp: '^(KUBELET_KUBEADM_ARGS=.*)$'
        line: >-
          \1 --container-runtime=remote --container-runtime-endpoint={{ containerd_socket if runtime_choice == 'containerd' else crio_socket }}
      notify: Restart kubelet
      register: _flags_edit

    - name: Fallback (if kubeadm-flags.env missing) ensure drop-in points to CRI
      when: _flags_edit is failed
      blockinfile:
        path: "{{ kubelet_dropin }}"
        create: yes
        block: |
          [Service]
          Environment="KUBELET_EXTRA_ARGS=--container-runtime=remote --container-runtime-endpoint={{ containerd_socket if runtime_choice == 'containerd' else crio_socket }}"
      notify: Restart kubelet

  post_tasks:
    - name: Wait for kubelet to settle a bit
      pause:
        seconds: 5

    - name: Reload systemd and restart kubelet (if notified)
      meta: flush_handlers

    - name: Wait for node to become Ready (via kubectl)
      delegate_to: localhost
      become: false
      command: >-
        {{ _kubectl_cmd }} wait node/{{ _shortname.stdout }}
        --for=condition=Ready
        --timeout={{ kube_wait_timeout }}

    - name: Uncordon node
      delegate_to: localhost
      become: false
      command: "{{ _kubectl_cmd }} uncordon {{ _shortname.stdout }}"
      ignore_errors: yes

    - name: Verify runtime now seen by Kubernetes
      delegate_to: localhost
      become: false
      command: >-
        {{ _kubectl_cmd }} get node {{ _shortname.stdout }}
        -o jsonpath='{.status.nodeInfo.containerRuntimeVersion}'
      register: _verify_runtime

    - name: Show runtime
      debug:
        msg: "Node {{ _shortname.stdout }} now uses: {{ _verify_runtime.stdout }}"

  handlers:
    - name: Restart containerd
      when: runtime_choice == "containerd"
      systemd:
        name: "{{ containerd_service }}"
        state: restarted
        daemon_reload: yes

    - name: Restart kubelet
      systemd:
        name: kubelet
        state: restarted
        daemon_reload: yes
4) How to run it
Migrate a single node first (recommended):

ansible-playbook -i inventory.ini migrate-runtime.yml -e "limit_nodes=worker1"
Migrate all nodes in the k8s_nodes group (do them one by one or with serial if you add it):

ansible-playbook -i inventory.ini migrate-runtime.yml
Tip: If you want to enforce one-by-one migration, add serial: 1 under the play header.

5) Rollback (quick)
If you must roll back to Docker temporarily:

Restore kubelet flags:

sudo cp /var/lib/kubelet/kubeadm-flags.env.backup_dockershim /var/lib/kubelet/kubeadm-flags.env
sudo systemctl daemon-reload
sudo systemctl restart kubelet
Make sure dockerd is running (if still installed), and crictl.yaml is removed or pointed back to Docker’s shim (older setups).

But ideally keep moving forward—dockershim is removed in modern K8s.

6) Notes (real-world)
Ensure pause image and SystemdCgroup=true (we did that) to avoid cgroup v2 issues.

Managed K8s (EKS/GKE/AKS) already uses containerd—no need to run this.

Test on staging first; confirm workloads re-schedule cleanly during the drain.

If you use CNI plugins that drop in containerd-specific config, validate they still match your node OS and K8s version.

