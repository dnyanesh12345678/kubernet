🔹 2. Add volumeMounts in container
Find container section:

containers:
  - name: {{ .Chart.Name }}
    image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
Add:

    volumeMounts:
      - name: default-volume
        mountPath: /data

      {{- if .Values.extraVolumeMounts }}
      {{- toYaml .Values.extraVolumeMounts | nindent 12 }}
      {{- end }}
