✅ template (deployment.yaml)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: test

spec:
  template:
    spec:
      containers:
        - name: app
          image: nginx

          volumeMounts:
            {{- if .Values.apiServer.extraVolumeMounts }}
            {{- toYaml .Values.apiServer.extraVolumeMounts | nindent 12 }}
            {{- end }}

